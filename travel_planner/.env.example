# Copy this file to travel_planner/.env and fill in real values.

# Gemini model access — create a free key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_gemini_api_key_here

# Duffel flight search (free test-mode tier) — sign up at https://duffel.com,
# then Dashboard > Developers > Access Tokens with "Developer test mode" on.
# Test tokens start with duffel_test_ and return sandbox data only (a
# fictional "Duffel Airways" carrier) — no real bookings, no payment risk.
DUFFEL_ACCESS_TOKEN=duffel_test_your_token_here

# Google Places API (New) for points of interest — create a Google Cloud
# project, enable "Places API (New)", enable billing (required even for the
# free monthly quota), then create an API key restricted to that API at
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
